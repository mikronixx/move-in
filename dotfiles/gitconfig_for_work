# This is Git's per-user configuration file.

[user]
#      name = your_user
#      email = your_user@example.com

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[init]
	templateDir = ~/.git-template
